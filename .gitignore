# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# copied into public/ during the GitHub Pages build
/public/library.json

# portable .labelator export artifacts (generated; not source of truth)
/artifacts/

# Local Python virtualenv (not source). Canonical renderer is tools/labelator_renderer.
/tools/labelator_renderer_poc/.venv/
/tools/**/__pycache__/
**/*.pyc
/tools/labelator_renderer/*.egg-info/
/tools/labelator_renderer/**/*.egg-info/
/tools/labelator_renderer/.venv/

# local Pilot SQLite (Node / cloud mode)
/data/labelator.db
/data/labelator.db-journal
