{
  "name": "labelator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "publish:labelator": "LABELATOR_PUBLISH=1 vite-node --config vitest.config.mts scripts/publish-labelator-packages.mts",
    "build": "npm run publish:labelator && next build",
    "build:pages": "npm run publish:labelator && cp data/library.json public/library.json && GITHUB_PAGES=true next build && touch out/.nojekyll",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:a3-warehouse": "vitest run tests/labelator-package.test.ts -t \"writes deterministic A3 Warehouse\"",
    "audit:renderer-compatibility": "vitest run tests/renderer-compatibility-audit.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "idb": "^8.0.3",
    "jsbarcode": "^3.12.3",
    "konva": "^10.3.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "^19.2.5",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "canvas": "^3.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
